# /etc/uma-edge/uma-edge.env
EDGE_LISTEN_ADDR=0.0.0.0:8012
EDGE_UPSTREAM_URL=ws://43.131.1.194:8011/uma/v1/ws
# 控制台：不填则不上报、也拿不到 console 签发的 token
EDGE_CONSOLE_URL=https://uma-console.chainee.space
# = console 的 CONSOLE_NODE_TOKEN
EDGE_CONSOLE_TOKEN=
# 默认取 /etc/hostname
EDGE_NODE_ID=hk-1
# 对外公布的地址；空则 console 用心跳来源 IP
EDGE_ADVERTISE_HOST=
EDGE_ADVERTISE_PORT=8012
EDGE_ADVERTISE_TLS=0
EDGE_CLIENT_QUEUE=128
EDGE_RING_FRAMES=4096
EDGE_MAX_CLIENTS=1000
# 节点自己的管理接口（/edge/admin/*）；空 = 管理接口全部拒绝
EDGE_ADMIN_TOKEN=
# 应急静态 token（逗号分隔）；只在 console 从未下发过集合时生效
EDGE_CLIENT_TOKENS=
EDGE_DRAIN_BATCH=20
EDGE_DRAIN_INTERVAL_MS=2000
EDGE_DRAIN_TIMEOUT_SECONDS=600
EDGE_HEARTBEAT_INTERVAL_SECONDS=5
RUST_LOG=info
