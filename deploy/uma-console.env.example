# /etc/uma-console/uma-console.env —— 三个 token 任一为空都拒绝启动
CONSOLE_LISTEN_ADDR=0.0.0.0:8013
# edge 心跳用（写进各 edge 的 EDGE_CONSOLE_TOKEN）
CONSOLE_NODE_TOKEN=
# 管理动作（drain/disable/token 管理），面板里输入
CONSOLE_ADMIN_TOKEN=
# 面板数据只读：https://console.example.com/?token=<CONSOLE_PANEL_TOKEN>
CONSOLE_PANEL_TOKEN=
CONSOLE_DATA_DIR=/var/lib/uma-console
CONSOLE_STALE_AFTER_SECONDS=15
CONSOLE_LIST_TTL_SECONDS=30
CONSOLE_UPSTREAM_HTTP=http://43.131.1.194:8011
# tinyuma 的 DASHBOARD_TOKEN，不填则面板只有 /healthz 那部分
CONSOLE_UPSTREAM_DASHBOARD_TOKEN=
CONSOLE_UPSTREAM_POLL_SECONDS=3
# 面板实时推送用的 tinyuma ws；不填则由 CONSOLE_UPSTREAM_HTTP 推导
CONSOLE_UPSTREAM_WS=ws://43.131.1.194:8011/uma/v1/ws
RUST_LOG=info
