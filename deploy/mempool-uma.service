[Unit]
Description=mempool-uma: rust-uma pipeline fed by Polygon mempool pending propose/dispute
After=network-online.target p2p-mempool-probe-b.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
EnvironmentFile=/etc/mempool-uma/mempool-uma.env
ExecStart=/opt/mempool-uma/mempool-uma
Restart=always
RestartSec=2s
TimeoutStopSec=10s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
StateDirectory=mempool-uma
StateDirectoryMode=0750

[Install]
WantedBy=multi-user.target
