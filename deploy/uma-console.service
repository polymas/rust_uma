[Unit]
Description=tinyuma fan-out cluster console (uma-console)
After=network-online.target
Wants=network-online.target
# Never stop restarting. With systemd's default (5 starts in 10s) a short
# crash loop — e.g. a bad env value with RestartSec=2s — leaves the unit
# "failed" for good and nothing brings it back until someone logs in.
StartLimitIntervalSec=0

[Service]
Type=simple
User=ubuntu
Group=ubuntu
EnvironmentFile=/etc/uma-console/uma-console.env
ExecStart=/opt/uma-console/uma-console
Restart=always
RestartSec=2s
TimeoutStopSec=10s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
StateDirectory=uma-console
StateDirectoryMode=0750

[Install]
WantedBy=multi-user.target
