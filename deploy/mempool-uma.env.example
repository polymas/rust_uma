# mempool-uma（polytest）。WSS_RPC / HTTP_RPC 只给"链上确认事件"订阅与启动回补用，不在热路径上。
API_ADDR=0.0.0.0:8013
DATA_DIR=/var/lib/mempool-uma
WSS_RPC=wss://polygon-provider.example/ws
HTTP_RPC=https://polygon-provider.example/http
REQUIRE_MARKET_ID=true
CLOSED_MARKET_LOOKBACK_DAYS=3
CATALOG_RECONCILE_INTERVAL_HOURS=6
MEMPOOL_FEED_ADDR=127.0.0.1:8014
MEMPOOL_SENDER_SEED=/opt/p2p-mempool-probe/sender_seed.json
MEMPOOL_BACKFILL_HOURS=3
MEMPOOL_BACKFILL_CHUNK=100
MEMPOOL_TRUST_MIN_N=50
MEMPOOL_TRUST_MIN_RATE=0.98
MEMPOOL_TIP_QUANTILE=0.05
