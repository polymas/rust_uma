WSS_RPC=wss://polygon-provider.example/ws
HTTP_RPC=https://polygon-provider.example/http

# Optional: comma-separated additional Polygon WSS endpoints raced against WSS_RPC
# for live subscription only (backfill/HTTP calls still use HTTP_RPC). Whichever
# endpoint delivers a given log first wins; duplicates are deduplicated downstream.
# Leave empty to keep a single connection (WSS_RPC). Example with two extra nodes:
# WSS_RPC_LIST=wss://provider-a.example/ws,wss://provider-b.example/ws
WSS_RPC_LIST=

API_ADDR=127.0.0.1:8011
DATA_DIR=./.cache

# Post-decode trust list. RPC collection itself filters by event topics, not address.
UMA_CONTRACT_ADDRESSES=0xCB1822859cEF82Cd2Eb4E6276C7916e692995130,0xeE3Afe347D5C74317041E2618C49534dAf887c24

# Empty means: subscribe first, then start from the current head on a new data directory.
# START_BLOCK=90000000
INITIAL_BACKFILL_DAYS=7
RPC_BACKFILL_BATCH_BLOCKS=1000
RPC_LIVE_BUFFER=8192

EVENT_RING_CAPACITY=10000
FRAME_RING_CAPACITY=2048
BATCH_MAX_EVENTS=64
BATCH_MAX_BYTES=32768
ZSTD_THRESHOLD=4096
MAX_DECOMPRESSED_BYTES=262144
WS_WRITE_TIMEOUT_MS=5000

GAMMA_BASE_URL=https://gamma-api.polymarket.com
GAMMA_REFRESH_INTERVAL_SECONDS=60
# Also cache Gamma markets that closed within this many days (in addition to
# the always-cached active/closed=false set). ProposePrice mostly fires right
# as a market closes, so without this the catalog misses most real events.
CLOSED_MARKET_LOOKBACK_DAYS=3
# Gamma's keyset pagination can silently drop entries (observed with batches
# of Neg Risk sibling markets sharing a near-identical updatedAt). This many
# hours between from-scratch reconciliation walks that self-heal any gap the
# incremental sync's cursor has already passed by (runs off the hot path).
CATALOG_RECONCILE_INTERVAL_HOURS=6
REQUIRE_MARKET_ID=true
