        { "regex": "\\bbetween\\s*[\\d,.]+\\S*\\s+and\\s+[\\d,.]+|\\b(less than|more than)\\s*[\\d,.]+\\s*(million|m|k)?\\s*(views|gross)\\b", "bet_type": "MEDIA_METRIC_RANGE" }
      ]
    }
  ]
}
