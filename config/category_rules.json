        { "tag_id": 972, "bet_type": "TWEET_COUNT" }
      ],
      "sports_market_type_rules": [],
      "question_text_rules": [
        { "regex": "^Will\\s.+\\swin\\s(the\\s)?.+(election|nomination|primary)\\b", "bet_type": "ELECTION_WINNER" },
        { "regex": "\\bFed\\b.*\\binterest rates?\\b", "bet_type": "FED_RATE_DECISION" },
        { "regex": "\\bpost\\s+[<\\d].*\\b(tweets|posts)\\b", "bet_type": "TWEET_COUNT" }
