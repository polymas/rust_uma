{
  "_comment": "匹配/加载逻辑见 src/category.rs；每条规则是怎么从真实抓到的 Gamma/链上数据推出来的，见相关会话记录。改规则改这个文件，同时去 src/category.rs 补一条回归测试，不要绕开规则条目直接改编译后的匹配逻辑。bet_type_groups 按一级分类分组——每个 Category 只会用自己那一组里的 tag/sportsMarketType/question 规则，不会跟别的分类混着匹配（历史教训：体育的 OUTRIGHT 文本规则 \"Will X win the Y?\" 曾经是全局共享的，能匹配到 \"Will Sarah Huckabee Sanders win the 2028 Republican presidential nomination?\" 这种政治选举市场，把 bet_type 错判成体育组的值）。",

  "tag_rules": [
    { "tag_id": 64, "category": "ESPORTS" },
    { "tag_id": 1, "category": "SPORTS" },
    { "tag_id": 84, "category": "WEATHER" },
    { "tag_id": 2, "category": "POLITICS" },
    { "tag_id": 21, "category": "CRYPTO" },
    { "tag_id": 596, "category": "CULTURE" }
  ],

  "bet_type_groups": [
    {
      "categories": ["SPORTS", "ESPORTS"],
      "fallback_bet_type": "SPORTS_PROP",
      "tag_bet_type_rules": [],
      "sports_market_type_rules": [
        { "contains": "child_moneyline", "bet_type": "GAME_WINNER" },
        { "contains": "moneyline", "bet_type": "MONEYLINE" },
        { "contains": "handicap", "bet_type": "SPREAD" },
        { "contains": "spread", "bet_type": "SPREAD" },
        { "contains": "total", "bet_type": "OVER_UNDER" },
        { "contains": "corners", "bet_type": "OVER_UNDER" },
        { "contains": "completed_match", "bet_type": "SPORTS_PROP" },
        { "contains": "to_score", "bet_type": "SPORTS_PROP" },
        { "contains": "exact_score", "bet_type": "SPORTS_PROP" },
        { "contains": "to_advance", "bet_type": "SPORTS_PROP" },
        { "contains": "result", "bet_type": "MONEYLINE" },
        { "contains": "winner", "bet_type": "MONEYLINE" }
      ],
      "question_text_rules": [
        { "regex": "\\bSpread:|\\bHandicap\\b", "bet_type": "SPREAD" },
        { "regex": "\\bO/U\\b|Over/Under", "bet_type": "OVER_UNDER" },
        { "regex": "\\b(Game|Map|Set|Leg)\\s*\\d+\\s*Winner\\b", "bet_type": "GAME_WINNER" },
        { "regex": "^[^:]+\\svs\\.?\\s[^:]+$", "bet_type": "MONEYLINE" },
        { "regex": "^Will\\s.+\\swin\\s(the\\s)?.+\\?$", "bet_type": "OUTRIGHT" }
      ]
    },
    {
      "categories": ["WEATHER"],
      "fallback_bet_type": "WEATHER_OTHER",
      "tag_bet_type_rules": [
        { "tag_id": 104596, "bet_type": "TEMP_HIGH" },
        { "tag_id": 104597, "bet_type": "TEMP_LOW" },
        { "tag_id": 103041, "bet_type": "PRECIPITATION" },
        { "tag_id": 103545, "bet_type": "PRECIPITATION" },
        { "tag_id": 103235, "bet_type": "PRECIPITATION" },
        { "tag_id": 106182, "bet_type": "PRECIPITATION" },
        { "tag_id": 1313, "bet_type": "PRECIPITATION" },
        { "tag_id": 102023, "bet_type": "STORM" },
        { "tag_id": 85, "bet_type": "STORM" },
        { "tag_id": 102186, "bet_type": "STORM" }
      ],
      "sports_market_type_rules": [],
      "question_text_rules": [
        { "regex": "highest temperature", "bet_type": "TEMP_HIGH" },
        { "regex": "lowest temperature", "bet_type": "TEMP_LOW" },
        { "regex": "\\bsnow\\b|precipitation|rainfall", "bet_type": "PRECIPITATION" },
        { "regex": "hurricane|tropical storm", "bet_type": "STORM" }
      ]
    },
    {
      "categories": ["CRYPTO"],
      "fallback_bet_type": "CRYPTO_PROP",
      "tag_bet_type_rules": [
        { "tag_id": 102134, "bet_type": "PRICE_TARGET" },
        { "tag_id": 102516, "bet_type": "PRICE_THRESHOLD" },
        { "tag_id": 102127, "bet_type": "UP_DOWN" }
      ],
      "sports_market_type_rules": [],
      "question_text_rules": [
        { "regex": "\\breach(es|ed)?\\s*\\$|\\bdip(s|ped)?\\s*to\\s*\\$", "bet_type": "PRICE_TARGET" },
        { "regex": "price of .+ be (above|below|over|under)\\s*\\$", "bet_type": "PRICE_THRESHOLD" },
        { "regex": "\\bUp or Down\\b", "bet_type": "UP_DOWN" }
